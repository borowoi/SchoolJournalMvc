@model ListViewModel<ClassRowViewModel>
@{
    ViewData["Title"] = "Классы";
}

<h2>Классы</h2>
<p class="text-muted">Показано записей: @Model.Items.Count из @Model.TotalCount (сначала последние учебные годы).</p>

<table class="table table-striped table-hover table-sm">
    <thead class="table-light">
        <tr>
            <th>Код</th>
            <th>Класс</th>
            <th>Учебный год</th>
            <th>Классный руководитель</th>
            <th>Учащихся</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td>@c.ClassID</td>
                <td>@c.Name</td>
                <td>@c.AcademicYear</td>
                <td>@(c.HomeroomTeacherName ?? "—")</td>
                <td>@c.StudentsCount</td>
            </tr>
        }
    </tbody>
</table>
